# Copiar a .env y completar. El archivo .env NO se versiona.

# --- Kafka ---
# Lista de brokers desde la que el AdminClient descubre el cluster. Basta con uno alcanzable, pero
# se nombran los tres: si kafka1 está caído, un solo bootstrap dejaría al servicio sin poder
# administrar un cluster que sigue en pie.
#
# Desde el host son los puertos publicados por el compose; dentro de la red de contenedores son
# los listeners internos, kafka1:29092,kafka2:29093,kafka3:29094.
KAFKA_BOOTSTRAP=localhost:9092,localhost:9093,localhost:9094

# --- Entra ID ---
# Mismo tenant y mismo registro de aplicación que el resto del sistema. Todas las rutas exigen el
# rol Admin del token.
AZURE_TENANT_ID=055d11d1-8ae0-4221-a6f7-b50be0a623b4
AZURE_CLIENT_ID=704a544f-3d92-44f5-aef9-8559574cff34

# La lista de tópicos protegidos (andesstay.kafka.protegidos) NO se expone como variable de
# entorno a propósito: desactivar el seguro por configuración sería perder justo lo que aporta.
